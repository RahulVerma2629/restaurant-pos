PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos?schema=public"
CORS_ORIGIN=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
MAX_FAILED_ATTEMPTS=5
# demo users created by `npm run seed` (never in production)
SEED_PASSWORD=Passw0rd!
SEED_PIN=1234

# --- Reliability module (Architecture, Integration & Reliability) ---
# memory = dev/test only. Use pg in staging/production.
RELIABILITY_STORE=memory
