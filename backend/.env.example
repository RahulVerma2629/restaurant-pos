PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://pos:pos@localhost:5432/pos?schema=public"
CORS_ORIGIN=http://localhost:5173
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
MAX_FAILED_ATTEMPTS=5
# demo users created by `npm run seed` (never in production)
SEED_PASSWORD=Passw0rd!
SEED_PIN=1234

# --- Reliability module (Architecture, Integration & Reliability) ---
# memory = dev/test only. Use pg in staging/production.
RELIABILITY_STORE=memory

# --- Integration between modules ---
# Shared secret the Orders module (Python) uses to send audit events to /api/v1/audit-logs/ingest. Leave empty to disable.
INTEGRATION_API_KEY=change-me-in-real-use
# Billing reads orders from here and updates their status (billed, paid, closed). Empty = billing runs standalone.
ORDERS_API_URL=http://localhost:8000/api/v1
DEFAULT_TAX_BASIS_POINTS=500
