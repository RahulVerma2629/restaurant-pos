DATABASE_URL=sqlite:///./pos_orders.db
# set to 0 when you manage the schema with migrations
AUTO_CREATE_DB=1

# --- Login and audit through the security module ---
# header = demo placeholder (X-User-Id / X-User-Role headers). security = real login with the Bearer token.
AUTH_MODE=header
SECURITY_API_URL=http://localhost:3000/api/v1
AUTH_CACHE_SECONDS=5
# Send order history to the security module's audit log (needs the same key as INTEGRATION_API_KEY there)
AUDIT_FORWARD=0
INTEGRATION_API_KEY=change-me-in-real-use
