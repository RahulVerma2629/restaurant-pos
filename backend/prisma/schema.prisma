// Security module models. If the team already has a schema.prisma, merge these in
// (keep one Branch model; coordinate with whoever owns restaurants/branches).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  active
  inactive
  locked
  pending
}

enum Scope {
  own
  branch
  all
}

enum ApprovalStatus {
  pending
  approved
  rejected
  used
}

model Branch {
  id     Int     @id @default(autoincrement())
  name   String
  active Boolean @default(true)
  users  User[]

  @@map("branches")
}

model User {
  id                 Int        @id @default(autoincrement())
  name               String
  username           String     @unique
  passwordHash       String?    @map("password_hash")
  pinHash            String?    @map("pin_hash")
  phone              String?
  email              String?
  branchId           Int        @map("branch_id")
  branch             Branch     @relation(fields: [branchId], references: [id])
  status             UserStatus @default(active)
  failedAttempts     Int        @default(0) @map("failed_attempts")
  mustChange         Boolean    @default(false) @map("must_change")
  createdAt          DateTime   @default(now()) @map("created_at")
  lastLoginAt        DateTime?  @map("last_login_at")
  roles              UserRole[]
  sessions           Session[]
  approvalsRequested Approval[] @relation("ApprovalRequester")
  approvalsDecided   Approval[] @relation("ApprovalDecider")

  @@map("users")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  module      String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  scope        Scope      @default(branch)
  limitValue   Decimal?   @map("limit_value") @db.Decimal(12, 2)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  user       User      @relation(fields: [userId], references: [id])
  terminalId String?   @map("terminal_id")
  tokenHash  String    @unique @map("token_hash")
  startedAt  DateTime  @default(now()) @map("started_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

model LoginActivity {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  username   String?
  terminalId String?  @map("terminal_id")
  ip         String?
  method     String
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("login_activity")
}

model Approval {
  id          Int            @id @default(autoincrement())
  action      String
  requestedBy Int            @map("requested_by")
  requester   User           @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  payload     Json
  reason      String
  status      ApprovalStatus @default(pending)
  decidedBy   Int?           @map("decided_by")
  decider     User?          @relation("ApprovalDecider", fields: [decidedBy], references: [id])
  decidedAt   DateTime?      @map("decided_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("approvals")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  userId     Int?     @map("user_id")
  role       String?
  branchId   Int?     @map("branch_id")
  terminalId String?  @map("terminal_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  reason     String?
  approvedBy Int?     @map("approved_by")
  ip         String?

  @@index([action])
  @@index([userId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
